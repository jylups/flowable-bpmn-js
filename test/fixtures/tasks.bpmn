<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://flowable.org/bpmn"
             id="Definitions_1">
  <process id="Process_1" isExecutable="true">
    <userTask id="UserTask_1" name="Review" flowable:assignee="${initiator}" flowable:async="true">
      <extensionElements>
        <flowable:taskListener event="create" class="org.example.CreateListener" />
        <flowable:executionListener event="start" class="org.example.StartListener" />
      </extensionElements>
    </userTask>
    <serviceTask id="HttpTask" name="Call" flowable:type="http" flowable:parallelInSameTransaction="true">
      <extensionElements>
        <flowable:field name="requestMethod">
          <flowable:string>POST</flowable:string>
        </flowable:field>
        <flowable:httpRequestHandler class="org.example.RequestHandler" />
        <flowable:executionListener event="end" class="org.example.EndListener" />
      </extensionElements>
    </serviceTask>
    <serviceTask id="ClassTask" name="Lookup" flowable:class="org.example.Lookup">
      <extensionElements>
        <flowable:field name="table">
          <flowable:string>orders</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <serviceTask id="MailTask" name="Notify" flowable:type="mail">
      <extensionElements>
        <flowable:field name="to">
          <flowable:string>kermit@example.org</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="UserTask_1_di" bpmnElement="UserTask_1">
        <dc:Bounds x="100" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HttpTask_di" bpmnElement="HttpTask">
        <dc:Bounds x="260" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClassTask_di" bpmnElement="ClassTask">
        <dc:Bounds x="420" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MailTask_di" bpmnElement="MailTask">
        <dc:Bounds x="580" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
