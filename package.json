{
  "name": "@jylups/flowable-bpmn-js",
  "version": "0.1.0",
  "description": "bpmn-js modeler and viewer with the Flowable BPMN extensions",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./assets/*": "./assets/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "assets",
    "dist"
  ],
  "scripts": {
    "lint": "eslint . && node tasks/build-icons-css.js --check",
    "test": "vitest run",
    "dev": "vitest",
    "distro": "rollup -c",
    "test:distro": "vitest run --config vitest.distro.config.js",
    "all": "npm run lint && npm test && npm run test:types && npm run distro && npm run test:distro",
    "test:types": "tsc -p test/types",
    "icons": "node tasks/build-icons-css.js",
    "prepack": "npm run distro"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jylups/flowable-bpmn-js.git"
  },
  "bugs": {
    "url": "https://github.com/jylups/bpmn-js-env/issues"
  },
  "homepage": "https://github.com/jylups/flowable-bpmn-js#readme",
  "keywords": [
    "bpmn",
    "bpmn-js",
    "modeler",
    "viewer",
    "flowable"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@bpmn-io/properties-panel": "^3.60.2",
    "@jylups/bpmn-js-properties-panel-flowable": "^0.1.0",
    "@jylups/flowable-bpmn-js-behaviors": "^0.1.0",
    "@jylups/flowable-bpmn-moddle": "^0.1.1",
    "bpmn-js": "^18.33.1",
    "bpmn-js-bpmnlint": "^0.25.0",
    "bpmn-js-properties-panel": "^5.65.4",
    "bpmnlint": "^12.0.0",
    "min-dom": "^5.3.0",
    "tiny-svg": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@vitest/browser-playwright": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "rollup": "4.68.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.1"
  },
  "types": "./index.d.ts"
}
